pipeline {
    
    agent any 
    
    environment {
        IMAGE_TAG = "${BUILD_NUMBER}"
        GIT_REPO_URL = 'https://github.com/Angurajnagaraj/new-test/'  // Your GitHub repository URL
        BRANCH_NAME = 'main'  // Branch you want to checkout, change as needed
	DOCKER_CREDENTIALS = credentials('DockerId')
	GITACCESS = credentials('Githubaccesstoken')
    }
    
    stages {
        
        stage('Checkout'){
           steps {
                git url: "${GIT_REPO_URL}", branch: "${BRANCH_NAME}"
           }
        }

        stage('Build Docker'){
            steps{
                script{
                    sh '''
                    cd python-web-app
                    cat Jenkinsfile
                    echo 'Buid Docker Image'
                    docker build -t angurajnagaraj/python-web-app:${BUILD_NUMBER} .
                    '''
                }
            }
        }
		
        stage('Login to Docker Hub') {
            steps {
                script {
                    sh "echo \$DOCKER_CREDENTIALS_PSW | docker login -u \$DOCKER_CREDENTIALS_USR --password-stdin"
                }
            }
        }
		
	stage('Push the artifacts'){
           steps{
                script{
                    sh '''
                    echo 'Push to Repo'
                    docker push angurajnagaraj/python-web-app:${BUILD_NUMBER}
                    '''
                }
            }
        }
		
     stage('Checkout K8S manifest SCM'){
            steps {
                git url: 'https://github.com/Angurajnagaraj/cicd-demo-manifests-repo',
                branch: "${BRANCH_NAME}"
            }
        }
		
	stage('Update K8S manifest & push to Repo'){
            steps {
                script{
                    withCredentials([usernamePassword(credentialsId: 'Newgithubid', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                        sh '''
			cat ${GITACCESS}
                        cat deploy.yaml
                        sed -i 's/17/${BUILD_NUMBER}/g' deploy.yaml
                        cat deploy.yaml
                        git add deploy.yaml
                        git commit -m 'Updated the deploy yaml | Jenkins Pipeline'
                        git remote -v
                        git push https://$GIT_USERNAME:GITACCESS@github.com/Angurajnagaraj/cicd-demo-manifests-repo.git HEAD:main
                        '''                        
                    }
                }
            }
        }
        
    }
}
